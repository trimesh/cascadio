{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh.primitive.TM_brep_faces.schema.json",
  "title": "TM_brep_faces mesh primitive extension",
  "type": "object",
  "description": "Which BREP face each triangle came from, the analytic surface of each face, and the materials of the source model",
  "properties": {
    "faceIndices": {
      "type": "integer",
      "minimum": 0,
      "description": "Index of accessor containing per-triangle face indices. Accessor must be SCALAR with unsigned integer component type. Count must equal number of triangles."
    },
    "faces": {
      "type": "array",
      "description": "One entry per BREP face, in face index order. An entry is null when the face is not one of the analytic surface types, so positions still match face indices.",
      "items": {
        "oneOf": [
          {
            "type": "null"
          },
          {"$ref": "#/$defs/face"}
        ]
      }
    },
    "materials": {
      "type": "array",
      "description": "Every material defined in the source model. The list describes the whole model, so it is the same on each primitive. Empty if the model defines none.",
      "items": {"$ref": "#/$defs/material"}
    }
  },
  "required": ["faceIndices", "faces", "materials"],
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3,
      "description": "A 3-component vector [x, y, z]"
    },
    "bounds": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2,
      "description": "A 2-component bounds array [min, max]"
    },
    "face": {
      "title": "BREP Face",
      "type": "object",
      "required": ["type", "face_index"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["plane", "cylinder", "cone", "sphere", "torus"]
        },
        "face_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of this face in the BREP model"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "plane"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {"$ref": "#/$defs/vec3"},
              "normal": {"$ref": "#/$defs/vec3"},
              "x_dir": {"$ref": "#/$defs/vec3"},
              "extent_x": {"$ref": "#/$defs/bounds", "description": "Extent in local X direction (meters)"},
              "extent_y": {"$ref": "#/$defs/bounds", "description": "Extent in local Y direction (meters)"}
            },
            "required": ["origin", "normal", "x_dir", "extent_x", "extent_y"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cylinder"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {"$ref": "#/$defs/vec3"},
              "axis": {"$ref": "#/$defs/vec3"},
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "extent_angle": {"$ref": "#/$defs/bounds", "description": "Angular extent around axis (radians)"},
              "extent_height": {"$ref": "#/$defs/bounds", "description": "Height extent along axis (meters)"}
            },
            "required": ["origin", "axis", "radius", "extent_angle", "extent_height"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cone"
              }
            }
          },
          "then": {
            "properties": {
              "apex": {"$ref": "#/$defs/vec3"},
              "axis": {"$ref": "#/$defs/vec3"},
              "semi_angle": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1.5707963267948966
              },
              "ref_radius": {
                "type": "number",
                "minimum": 0
              },
              "extent_angle": {"$ref": "#/$defs/bounds", "description": "Angular extent around axis (radians)"},
              "extent_distance": {"$ref": "#/$defs/bounds", "description": "Distance extent from apex (meters)"}
            },
            "required": ["apex", "axis", "semi_angle", "ref_radius", "extent_angle", "extent_distance"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sphere"
              }
            }
          },
          "then": {
            "properties": {
              "center": {"$ref": "#/$defs/vec3"},
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "extent_longitude": {"$ref": "#/$defs/bounds", "description": "Longitude extent (radians)"},
              "extent_latitude": {"$ref": "#/$defs/bounds", "description": "Latitude extent (radians)"}
            },
            "required": ["center", "radius", "extent_longitude", "extent_latitude"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "torus"
              }
            }
          },
          "then": {
            "properties": {
              "center": {"$ref": "#/$defs/vec3"},
              "axis": {"$ref": "#/$defs/vec3"},
              "major_radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minor_radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "extent_major_angle": {"$ref": "#/$defs/bounds", "description": "Angle extent around main axis (radians)"},
              "extent_minor_angle": {"$ref": "#/$defs/bounds", "description": "Angle extent around tube (radians)"}
            },
            "required": ["center", "axis", "major_radius", "minor_radius", "extent_major_angle", "extent_minor_angle"]
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rgb": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "A color [red, green, blue], each from 0 to 1"
    },
    "rgba": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "A color [red, green, blue, alpha], each from 0 to 1"
    },
    "material": {
      "title": "Material",
      "type": "object",
      "description": "Either a physical material (name, density) or a visual one (colors), as the source file defined it. Every field is optional.",
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "density": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "In the unit given by density_name"
        },
        "density_name": {
          "type": "string",
          "description": "What the density value measures and its unit, as written in the source file"
        },
        "density_value_type": {"type": "string"},
        "base_color": {"$ref": "#/$defs/rgba"},
        "alpha_cutoff": {"type": "number"},
        "pbr": {
          "type": "object",
          "description": "Metallic-roughness parameters, as in glTF",
          "properties": {
            "base_color": {"$ref": "#/$defs/rgba"},
            "metallic": {"type": "number"},
            "roughness": {"type": "number"},
            "refraction_index": {"type": "number"},
            "emissive_factor": {"$ref": "#/$defs/vec3"}
          },
          "additionalProperties": false
        },
        "common": {
          "type": "object",
          "description": "Classic ambient/diffuse/specular parameters",
          "properties": {
            "ambient_color": {"$ref": "#/$defs/rgb"},
            "diffuse_color": {"$ref": "#/$defs/rgb"},
            "specular_color": {"$ref": "#/$defs/rgb"},
            "emissive_color": {"$ref": "#/$defs/rgb"},
            "shininess": {"type": "number"},
            "transparency": {"type": "number"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
