# Docker ignore for cibuildwheel builds
# Prevents local build artifacts from being copied into container

# CMake build directories; OpenCASCADE is rebuilt inside the container
build/
occt_install/

# Built wheels
wheelhouse/

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Git
.git/
.gitignore
.gitmodules

# Editor/IDE
*.swp
*.swo
*~
.vscode/
.idea/

# Test artifacts
*.glb
*.obj
